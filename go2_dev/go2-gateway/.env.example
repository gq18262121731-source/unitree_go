GO2_MODE=mock
ROBOT_PROVIDER=mock
REAL_MOTION_ENABLED=false
GO2_ROBOT_ID=go2-edu-001
UNITREE_ROBOT_IP=192.168.123.161
UNITREE_NETWORK_INTERFACE=eth0
UNITREE_DOMAIN_ID=0
UNITREE_DDS_TIMEOUT_SECONDS=10
UNITREE_REQUIRE_DDS_STATE=true
GO2_ROBOT_IP=192.168.123.161
GO2_NETWORK_INTERFACE=eth0
GO2_CONTROL_ENABLED=false
GO2_READ_ONLY_MODE=false
GO2_SDK_TIMEOUT_SECONDS=3
GO2_STATE_STALE_SECONDS=2
# WebRTC hard failures always rebuild a fresh PeerConnection. Soft media/state
# staleness remains DEGRADED by default and does not create a reconnect storm.
GO2_WEBRTC_RECONNECT_INITIAL_SECONDS=2
GO2_WEBRTC_RECONNECT_STEP_SECONDS=2
GO2_WEBRTC_RECONNECT_MAX_SECONDS=15
GO2_WEBRTC_RECONNECT_STABLE_RESET_SECONDS=30
GO2_WEBRTC_DISCONNECT_GRACE_SECONDS=3
GO2_WEBRTC_RECONNECT_ON_STALE=false
GO2_WEBRTC_STALE_GRACE_SECONDS=10
# Diagnostic only: enables Video OFF/ON plus video-only reconnect escalation.
# Formal runtime keeps a stale video signal DEGRADED and preserves transport.
GO2_WEBRTC_ENABLE_VIDEO_ACTIVE_RECOVERY=false
# BASE Runtime starts with video only. Companion and voice layers activate
# their state/audio inputs on demand; explicit true values remain diagnostic overrides.
GO2_WEBRTC_ENABLE_SPORT_STATE=false
GO2_WEBRTC_ENABLE_UWB=false
GO2_WEBRTC_ENABLE_MULTIPLE_STATE=false
GO2_WEBRTC_ENABLE_LOW_STATE=false
GO2_WEBRTC_ENABLE_AUDIO=false
GO2_MAX_VX=0.30
GO2_MAX_VY=0.0
GO2_MAX_WZ=0.30
GO2_MIN_MOVE_DURATION=0.05
GO2_MAX_MOVE_DURATION=1.0
GO2_CONTROL_WATCHDOG_SECONDS=0.5
FOLLOW_SIMULATION=true
FOLLOW_EXECUTION_ENABLED=false
# Latest-only Go2 UWB/follow target UDP telemetry for camera-service.
FOLLOW_TARGET_FORWARD_ENABLED=false
FOLLOW_TARGET_MONITORING_ENABLED=true
FOLLOW_TARGET_FORWARD_HOST=
FOLLOW_TARGET_FORWARD_PORT=8766
FOLLOW_TARGET_FORWARD_HZ=20
FOLLOW_TARGET_FORWARD_STALE_SECONDS=1.0
FOLLOW_TARGET_FORWARD_STATS_INTERVAL_SECONDS=10
PHASE7_MOTION_EXECUTION_ENABLED=false
# true = full fall-preemption mode; false = explicit follow-only mode.
PHASE7_REQUIRE_EXTERNAL_RISK_FEED=true
GO2_COMPANION_CONFIG=configs/companion_follow_demo.yaml
GO2_COMPANION_STARTUP_TIMEOUT_SECONDS=3.0
# Required only when PHASE7_REQUIRE_EXTERNAL_RISK_FEED=true.
GO2_COMPANION_RISK_EVENTS_PATH=
GO2_COMPANION_STATE_PATH=data/companion_lifecycle_state.json
GO2_LOG_LEVEL=INFO
GO2_CAMERA_TIMEOUT_SECONDS=3
GO2_CAMERA_SNAPSHOT_URL=/api/camera/snapshot
GO2_CAMERA_STREAM_URL=/api/camera/stream
GO2_CAMERA_STREAM_INTERVAL_SECONDS=0.5
GO2_TASK_EVIDENCE_DIR=data/task_evidence
GO2_VOICE_MODE=mock
# Unified WebRTC voice-control capture. 300 ms is the frozen competition value.
GO2_VOICE_CAPTURE_SECONDS=8.0
GO2_VOICE_VAD_TRAILING_SILENCE_SECONDS=0.3

# Raw per-sample WebRTC UWB payload logging. Keep disabled for normal runtime.
GO2_UWB_VERBOSE=0

# Raw WebRTC protocol logs (state/heartbeat/rtc_inner_req plus AudioHub
# chunk progress, request/response payloads, Base64 and full audio_list JSON).
GO2_VERBOSE_PROTOCOL_LOG=0
# Debug only. Production START uses Lifecycle readiness gates without a phrase.
GO2_MANUAL_CONFIRM_START=0
GO2_FALL_PROMPT=您好，请问您现在是否需要帮助？
GO2_VOICE_PROMPT_URL=
GO2_VOICE_PROMPT_TIMEOUT_SECONDS=2
GO2_VOICE_PROMPT_RETRIES=1
GO2_VOICE_PROMPT_RETRY_DELAY_SECONDS=0.2
GO2_ELDER_RESPONSE_TIMEOUT_SECONDS=3
GO2_MOCK_CONFIRM_FALL_OUTCOME=NO_RESPONSE
GO2_TASK_AUDIT_ENABLED=true
GO2_TASK_AUDIT_LOG_PATH=logs/task-events.jsonl
GO2_LOCATION_MOTION_PLANS_JSON=
HEALTH_NEW_CALLBACK_URL=
HEALTH_NEW_CALLBACK_TOKEN=
HEALTH_NEW_CALLBACK_TIMEOUT_SECONDS=2
HEALTH_NEW_CALLBACK_RETRIES=2
HEALTH_NEW_CALLBACK_RETRY_DELAY_SECONDS=0.2
